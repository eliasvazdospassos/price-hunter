# Price Hunter — Configuração de Ambiente
# Copie este arquivo para .env e preencha apenas as credenciais que desejar ativar.
# NUNCA versione o arquivo .env nem exponha chaves privadas no frontend.

# Servidor
PRICE_HUNTER_HOST=127.0.0.1
PRICE_HUNTER_PORT=8000
PRICE_HUNTER_ENV=development

# Segredo para assinatura de sessões (gere uma string aleatória longa em produção)
PRICE_HUNTER_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria-com-32-caracteres-ou-mais

# Banco de dados: auto (usa Firestore no Cloud Run e SQLite localmente) | sqlite | firestore
PRICE_HUNTER_DB_BACKEND=auto
PRICE_HUNTER_DB_PATH=data/price_hunter.db

# Google Cloud / Firestore (usado no Google Cloud Run via ADC, sem chaves estáticas)
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)

# Rate limiting (requisições por minuto por IP)
PRICE_HUNTER_RATE_LIMIT_PER_MIN=60

# Timeout padrão (segundos) para chamadas a provedores externos
PRICE_HUNTER_PROVIDER_TIMEOUT=10

# --- Autenticação e Banco em Nuvem (Opcional: Supabase) ---
# Quando configurado, permite migrar autenticação e persistência para Supabase.
# Veja supabase/schema.sql para as tabelas e políticas RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedores de Ofertas que Exigem Credenciais Oficiais ---

# Mercado Livre (OAuth 2.0 - https://developers.mercadolivre.com.br/devcenter)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_ACCESS_TOKEN=

# Amazon Brasil (PA-API 5.0 - Programa de Associados Amazon)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Shopee Brasil (Shopee Affiliate Open Platform)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Magazine Luiza (Magalu Partners / Open API)
MAGALU_API_KEY=

# Casas Bahia (Rede de Afiliados Awin)
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# Google Shopping via SerpAPI (Opcional - https://serpapi.com/)
SERPAPI_API_KEY=
